# Firebase Web App Configuration (Client - Safe for Public Client Bundles)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK Credentials (Server ONLY - NEVER expose or commit to public client code)
# Option 1: Path to JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Option 2: JSON string of service account key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Server Environment Configuration
PORT=3000
NODE_ENV=development
